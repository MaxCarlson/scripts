{
  "default_targets": [
    "rrbackup"
  ],
  "targets": {
    "rrbackup": {
      "description": "RRBackup consolidation, compatibility, viewer, scheduler, and alerting validation.",
      "working_directory": "modules/rrbackup",
      "context_files": [
        "docs/plans/20260729-0700_rrbackup-consolidation-viewer-alerting/STATUS.md",
        "docs/plans/20260729-0700_rrbackup-consolidation-viewer-alerting/checklist.md"
      ],
      "environment": {
        "PYTHONUTF8": "1",
        "PYTHONUNBUFFERED": "1",
        "PYTHONPATH": "{target_root}",
        "RRBACKUP_INCLUDE_PRODUCTION_READ_ONLY": "{include_production_read_only}"
      },
      "bootstrap": [
        {
          "name": "Install RRBackup editable development dependencies",
          "executable": "{python}",
          "arguments": [
            "-m",
            "pip",
            "install",
            "--disable-pip-version-check",
            "--no-build-isolation",
            "-e",
            "{target_root}[dev]"
          ]
        }
      ],
      "commands": [
        {
          "name": "Compile RRBackup package and tests",
          "executable": "{python}",
          "arguments": [
            "-m",
            "compileall",
            "-q",
            "rrbackup",
            "tests"
          ]
        },
        {
          "name": "Lint RRBackup safety foundation",
          "executable": "{python}",
          "arguments": [
            "-m",
            "ruff",
            "check",
            "rrbackup/engine.py",
            "rrbackup/locking.py",
            "rrbackup/models.py",
            "rrbackup/policy.py",
            "rrbackup/profile.py",
            "rrbackup/restic.py",
            "rrbackup/snapshots.py",
            "rrbackup/state.py",
            "tests/engine_test.py",
            "tests/locking_test.py",
            "tests/models_test.py",
            "tests/policy_test.py",
            "tests/profile_test.py",
            "tests/restic_test.py",
            "tests/snapshots_test.py",
            "tests/state_test.py"
          ]
        },
        {
          "name": "RRBackup pytest and coverage suite",
          "executable": "{python}",
          "arguments": [
            "-m",
            "pytest",
            "tests",
            "-vv",
            "-ra",
            "--tb=short",
            "--durations=25",
            "--strict-config",
            "--strict-markers",
            "--import-mode=importlib",
            "--rootdir",
            "{target_root}",
            "--basetemp",
            "{temp_root}",
            "--cov=rrbackup",
            "--cov-branch",
            "--cov-report=term-missing"
          ]
        }
      ],
      "powershell_tests": [
        {
          "glob": "tests/powershell/*_test.ps1",
          "arguments": [
            "-RepoRoot",
            "{repo_root}",
            "-PythonExecutable",
            "{python}",
            "-IncludeProductionReadOnly:{include_production_read_only_bool}"
          ]
        }
      ]
    }
  }
}

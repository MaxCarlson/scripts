{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.invalid/development-ledger/repository-config.schema.json",
    "title": "Development Ledger Repository Configuration",
    "type": "object",
    "required": [
        "schema_version",
        "repository_name",
        "instruction_strategy",
        "agents",
        "scopes",
        "workflow_document"
    ],
    "properties": {
        "schema_version": {
            "const": 1
        },
        "repository_name": {
            "type": "string",
            "minLength": 1
        },
        "instruction_strategy": {
            "const": "essential-inline-plus-native-imports"
        },
        "agents": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "enum": ["codex", "claude", "gemini", "copilot"]
            }
        },
        "workflow_document": {
            "type": "string",
            "minLength": 1
        },
        "scopes": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["path", "docs_path", "plan_root"],
                "properties": {
                    "path": {
                        "type": "string",
                        "minLength": 1
                    },
                    "docs_path": {
                        "type": "string",
                        "minLength": 1
                    },
                    "plan_root": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "additionalProperties": true
            }
        }
    },
    "additionalProperties": true
}

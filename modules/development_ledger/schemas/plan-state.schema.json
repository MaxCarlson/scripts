{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.invalid/development-ledger/plan-state.schema.json",
    "title": "Development Ledger Plan State",
    "type": "object",
    "required": ["schema_version", "plan_id", "title", "project_root", "stage", "session", "items"],
    "properties": {
        "schema_version": {"const": 1},
        "plan_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "project_root": {"type": "string", "minLength": 1},
        "stage": {
            "type": "object",
            "required": ["id"],
            "properties": {
                "id": {"type": "string", "minLength": 1},
                "title": {"type": "string"},
                "status": {"type": "string"}
            },
            "additionalProperties": true
        },
        "session": {
            "type": "object",
            "properties": {
                "actor": {"type": "string"},
                "mode": {"type": "string"},
                "objective": {"type": "string"},
                "hypothesis": {"type": "string"},
                "target_ids": {"type": "array", "items": {"type": "string"}},
                "environment_dependencies": {"type": "array", "items": {"type": "string"}},
                "diagnostic_complexity": {"enum": ["mechanical", "normal", "complex", "deep", "critical"]},
                "relevant_files": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": true
        },
        "items": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["id", "title"],
                "properties": {
                    "id": {"type": "string", "minLength": 1},
                    "title": {"type": "string", "minLength": 1},
                    "kind": {"type": "string"},
                    "implementation": {"enum": ["planned", "in_progress", "implemented", "blocked", "deferred"]},
                    "tests": {"type": "array", "items": {"type": "string"}},
                    "manual_checks": {"type": "array", "items": {"type": "string"}},
                    "blocked_by": {"type": "array", "items": {"type": "string"}},
                    "relevant_files": {"type": "array", "items": {"type": "string"}},
                    "notes": {"type": "string"}
                },
                "additionalProperties": false
            }
        },
        "manual_checks": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["id", "title", "item_ids", "instructions", "expected"],
                "properties": {
                    "id": {"type": "string", "minLength": 1},
                    "title": {"type": "string", "minLength": 1},
                    "item_ids": {"type": "array", "items": {"type": "string"}},
                    "instructions": {"type": "array", "items": {"type": "string"}},
                    "expected": {"type": "string", "minLength": 1},
                    "platform": {"type": "string"},
                    "status": {"enum": ["pending", "passed", "failed", "blocked", "waived"]},
                    "safety": {"type": "string"},
                    "notes": {"type": "string"}
                },
                "additionalProperties": false
            }
        },
        "relevant_docs": {"type": "array", "items": {"type": "string"}},
        "metadata": {"type": "object"}
    },
    "additionalProperties": false
}
